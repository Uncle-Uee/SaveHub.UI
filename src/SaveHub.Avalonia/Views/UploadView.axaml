<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveHub.Avalonia.ViewModels"
             xmlns:models="using:SaveHub.Avalonia.Models"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="600"
             x:Class="SaveHub.Avalonia.Views.UploadView"
             x:DataType="vm:UploadViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="10">

            <TextBlock Text="Device" FontWeight="Bold"/>
            <DropDownButton Content="{Binding SelectedDeviceDisplay}" MinWidth="260" HorizontalAlignment="Left">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Nintendo">
                            <MenuItem Header="NES" Command="{Binding SelectDeviceCommand}" CommandParameter="NES"/>
                            <MenuItem Header="SNES" Command="{Binding SelectDeviceCommand}" CommandParameter="SNES"/>
                            <MenuItem Header="N64" Command="{Binding SelectDeviceCommand}" CommandParameter="N64"/>
                            <MenuItem Header="GameCube" Command="{Binding SelectDeviceCommand}" CommandParameter="GC"/>
                            <MenuItem Header="Wii" Command="{Binding SelectDeviceCommand}" CommandParameter="WII"/>
                            <MenuItem Header="Switch" Command="{Binding SelectDeviceCommand}" CommandParameter="SWITCH"/>
                            <MenuItem Header="Game Boy" Command="{Binding SelectDeviceCommand}" CommandParameter="GB"/>
                            <MenuItem Header="Game Boy Color" Command="{Binding SelectDeviceCommand}" CommandParameter="GBC"/>
                            <MenuItem Header="GBA" Command="{Binding SelectDeviceCommand}" CommandParameter="GBA"/>
                            <MenuItem Header="NDS" Command="{Binding SelectDeviceCommand}" CommandParameter="DS"/>
                            <MenuItem Header="3DS" Command="{Binding SelectDeviceCommand}" CommandParameter="3DS"/>
                            <MenuItem Header="Virtual Boy" Command="{Binding SelectDeviceCommand}" CommandParameter="VB"/>
                        </MenuItem>
                        <MenuItem Header="Sony">
                            <MenuItem Header="PS1" Command="{Binding SelectDeviceCommand}" CommandParameter="PS1"/>
                            <MenuItem Header="PS2" Command="{Binding SelectDeviceCommand}" CommandParameter="PS2"/>
                            <MenuItem Header="PS3" Command="{Binding SelectDeviceCommand}" CommandParameter="PS3"/>
                            <MenuItem Header="PS4" Command="{Binding SelectDeviceCommand}" CommandParameter="PS4"/>
                            <MenuItem Header="PS5" Command="{Binding SelectDeviceCommand}" CommandParameter="PS5"/>
                            <MenuItem Header="PSP" Command="{Binding SelectDeviceCommand}" CommandParameter="PSP"/>
                            <MenuItem Header="PS Vita" Command="{Binding SelectDeviceCommand}" CommandParameter="PSV"/>
                        </MenuItem>
                        <MenuItem Header="Microsoft">
                            <MenuItem Header="Xbox" Command="{Binding SelectDeviceCommand}" CommandParameter="XBOX"/>
                            <MenuItem Header="Xbox 360" Command="{Binding SelectDeviceCommand}" CommandParameter="X360"/>
                        </MenuItem>
                        <MenuItem Header="Sega">
                            <MenuItem Header="Genesis" Command="{Binding SelectDeviceCommand}" CommandParameter="GENESIS"/>
                            <MenuItem Header="Dreamcast" Command="{Binding SelectDeviceCommand}" CommandParameter="DREAMCAST"/>
                        </MenuItem>
                        <MenuItem Header="Desktop Gaming">
                            <MenuItem Header="PC" Command="{Binding SelectDeviceCommand}" CommandParameter="PC"/>
                        </MenuItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <TextBlock Text="Save type" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="saveType" Content="Save State" IsChecked="{Binding IsSaveState}"/>
                <RadioButton GroupName="saveType" Content="Save Folder" IsChecked="{Binding IsSaveFolder}"/>
                <RadioButton GroupName="saveType" Content="Memory Card" IsChecked="{Binding IsMemoryCard}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Browse Files..." Command="{Binding BrowseCommand}" ToolTip.Tip="Pick the save file(s) to upload"/>
                <Button Content="Browse Folder..." Command="{Binding BrowseFolderCommand}" ToolTip.Tip="Pick a save folder to upload"/>
                <Button Content="Select Icon..." Command="{Binding SelectIconCommand}" ToolTip.Tip="Pick a cover image for this game (shown below)"/>
            </StackPanel>
            <TextBox Text="{Binding PathText}" IsReadOnly="True" PlaceholderText="No files selected"/>

            <Grid Height="248" ColumnDefinitions="*,Auto">
                <DataGrid Grid.Column="0" ItemsSource="{Binding Files}" IsReadOnly="True"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          GridLinesVisibility="All" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Width="140" Margin="8,0,0,0" Spacing="6">
                    <Button Content="Add file(s)…" Command="{Binding AddFilesCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Add more file(s) to this upload"/>
                    <Button Content="Edit name" Click="EditName_Click" HorizontalAlignment="Stretch" ToolTip.Tip="Rename this upload (edits the Game Name)"/>
                    <Button Content="Remove" Command="{Binding RemoveFileCommand}" HorizontalAlignment="Stretch" ToolTip.Tip="Remove the selected file from this upload"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Padding="2"
                        VerticalAlignment="Top" IsVisible="{Binding HasIconPreview}">
                    <Image Source="{Binding IconPreview}" Width="128" Height="128" Stretch="Uniform"/>
                </Border>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Title ID" Width="90" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding TitleId}" Width="240" PlaceholderText="e.g. SLUS-12345 (auto-detected for PlayStation)"/>
                        <Button Content="Detect" Command="{Binding DetectTitleIdCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Game Name" Width="90" VerticalAlignment="Center"/>
                        <TextBox x:Name="GameNameBox" Text="{Binding GameName}" Width="340" PlaceholderText="Shown in your library; required for PC save folders"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Description" FontWeight="Bold"/>
            <TextBox Text="{Binding Description}" MaxLength="{Binding MaxDescriptionLength}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                     PlaceholderText="Describe this save (e.g. ‘Chapter 5, all upgrades’)"/>
            <TextBlock Text="{Binding DescriptionCount}" HorizontalAlignment="Right" Foreground="Gray"/>

            <Button Content="Upload" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" MinWidth="120"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
