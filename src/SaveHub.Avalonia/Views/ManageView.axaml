<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveHub.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="600"
             x:Class="SaveHub.Avalonia.Views.ManageView"
             x:DataType="vm:ManageViewModel">

    <Grid Margin="14" ColumnDefinitions="*,12,240" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" Width="170" PlaceholderText="System"/>
            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Width="170" PlaceholderText="Game"/>
            <Button Content="Refresh" Command="{Binding RefreshSystemsCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBox Text="{Binding GameFilter}" Width="170" PlaceholderText="Filter games"/>
            <TextBox Text="{Binding SaveFilter}" Width="220" PlaceholderText="Filter saves"/>
        </StackPanel>

        <DataGrid x:Name="SavesGrid" Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"
                  ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}"
                  SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                  IsReadOnly="True" GridLinesVisibility="All"
                  CanUserResizeColumns="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Archive" Binding="{Binding Archive}" Width="130"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Margin="0,0,0,0" Spacing="10">
            <Border Height="180" Background="#22808080" CornerRadius="4">
                <Image Source="{Binding IconBitmap}" Stretch="Uniform" Margin="6"/>
            </Border>
            <TextBlock Text="{Binding NameText}" TextWrapping="Wrap"/>

            <Border IsVisible="{Binding HasSelection}" Background="#0F000000" CornerRadius="4" Padding="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="Selected save" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedArchive, StringFormat='Archive: {0}'}"/>
                    <TextBlock Text="{Binding SelectedType, StringFormat='Type: {0}'}"/>
                    <TextBlock Text="{Binding SelectedIndex, StringFormat='Index: {0}'}"/>
                    <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Button Content="Download Selected..." Command="{Binding DownloadSelectedCommand}" HorizontalAlignment="Stretch"/>
            <Button Content="Delete Selected" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Stretch"/>
            <Button Content="Delete All (game)" Command="{Binding DeleteAllCommand}" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
