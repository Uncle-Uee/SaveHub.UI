<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SaveHub.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="600"
             x:Class="SaveHub.Avalonia.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

    <Grid Margin="14" ColumnDefinitions="*,12,230" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" Width="200" PlaceholderText="System"/>
            <Button Content="Refresh" Command="{Binding RefreshSystemsCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                  ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}"
                  IsReadOnly="True" GridLinesVisibility="All" CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Title ID" Binding="{Binding TitleId}" Width="100"/>
                <DataGridTextColumn Header="Archive" Binding="{Binding Archive}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Spacing="10">
            <Border Height="200" Background="#22808080" CornerRadius="4">
                <Image Source="{Binding IconBitmap}" Stretch="Uniform" Margin="6"/>
            </Border>
            <TextBlock Text="{Binding NameText}" TextWrapping="Wrap"/>
            <Button Content="Download..." Command="{Binding DownloadCommand}" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
