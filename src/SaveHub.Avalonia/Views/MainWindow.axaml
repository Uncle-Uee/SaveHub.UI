<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaveHub.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="640"
        x:Class="SaveHub.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Width="1024" Height="960"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="SaveHub">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Data Folder" Command="{Binding OpenDataFolderCommand}"/>
                <MenuItem Header="Open Cover _Cache" Command="{Binding OpenCoverCacheCommand}"/>
                <Separator/>
                <MenuItem Header="_Quit" Command="{Binding QuitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Rebuild Library Index" Command="{Binding RebuildLibraryCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation (README)" Command="{Binding OpenReadmeCommand}"/>
                <MenuItem Header="_Source project" Command="{Binding OpenSourceCommand}"/>
                <MenuItem Header="Support / _Donate" Command="{Binding DonateCommand}"/>
                <Separator/>
                <MenuItem Header="_About SaveHub" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="1" Width="140" Margin="10,0" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="❤ Donate" Command="{Binding DonateCommand}"/>
            </Grid>
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Upload">
                <ContentControl Content="{Binding Upload}"/>
            </TabItem>
            <TabItem Header="Bulk Upload">
                <ContentControl Content="{Binding BulkUpload}"/>
            </TabItem>
            <TabItem Header="Download">
                <ContentControl Content="{Binding Download}"/>
            </TabItem>
            <TabItem Header="Edit">
                <ContentControl Content="{Binding Edit}"/>
            </TabItem>
            <TabItem Header="Manage">
                <ContentControl Content="{Binding Manage}"/>
            </TabItem>
            <TabItem Header="Library">
                <ContentControl Content="{Binding Library}"/>
            </TabItem>
            <TabItem Header="Settings">
                <ContentControl Content="{Binding Settings}"/>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
