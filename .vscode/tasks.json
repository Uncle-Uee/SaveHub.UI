{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-avalonia",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/SaveHub.Avalonia/SaveHub.Avalonia.csproj",
                "-p:UseLocalSaveHub=true",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "build-winforms",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/SaveHub.WinForms/SaveHub.WinForms.csproj",
                "-p:UseLocalSaveHub=true",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
