<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local dev feed: run pack-api.ps1 in the sibling SaveHub repo to fill it. -->
    <add key="savehub-local" value="..\SaveHub\local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="SaveHub.*" />
    </packageSource>
    <packageSource key="savehub-local">
      <package pattern="SaveHub.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
